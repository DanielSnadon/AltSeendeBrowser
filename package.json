{
  "name": "altseende-browser",
  "productName": "AltSeende Browser",
  "version": "0.1.0",
  "private": true,
  "description": "A minimal Chromium-powered research browser",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "pack": "electron-packager . AltSeende --platform=linux --arch=x64 --out=dist --overwrite --ignore=^/test --ignore=^/dist"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1"
  }
}
