{
  "name": "altseende-browser",
  "productName": "AltSeende Browser",
  "version": "0.4.0",
  "private": true,
  "description": "A minimal Chromium-powered research browser",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/*.test.cjs",
    "smoke": "electron . --smoke-test",
    "pack": "electron-packager . AltSeende --platform=linux --arch=x64 --out=dist --overwrite --ignore=^/test --ignore=^/dist",
    "filters": "node src/filters.cjs",
    "dist": "npm run filters && npm run tunnel && electron-builder --linux AppImage tar.gz --publish never && node scripts/build-rpm.cjs",
    "dist:win": "npm run filters && electron-builder --win nsis --publish never",
    "test:restart": "node scripts/test-restart.cjs",
    "tunnel": "node scripts/tunnel.cjs"
  },
  "devDependencies": {
    "@electron/packager": "20.3.0",
    "electron": "44.5.1",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "@ghostery/adblocker": "2.18.2",
    "darkreader": "4.9.133",
    "qrcode": "1.5.4",
    "tldts-experimental": "7.0.25"
  },
  "author": {
    "name": "Daniel Snadon",
    "email": "danielsnadon@gmail.com"
  },
  "homepage": "https://github.com/DanielSnadon/AltSeendeBrowser",
  "build": {
    "appId": "com.altseende.browser",
    "productName": "AltSeende Browser",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "README.md",
      "THIRD_PARTY.md",
      "!assets/tunnel/**/*"
    ],
    "asar": true,
    "linux": {
      "executableName": "altseende-browser",
      "icon": "assets/icon.png",
      "category": "Network",
      "artifactName": "AltSeende-${version}-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "AltSeende Browser",
          "Comment": "Private research browser with split views",
          "StartupWMClass": "altseende-browser",
          "Categories": "Network;WebBrowser;"
        }
      },
      "syncDesktopName": true
    },
    "win": {
      "icon": "assets/icon.png",
      "target": "nsis",
      "artifactName": "AltSeende-Setup-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "compression": "normal",
    "extraResources": [
      {
        "from": "assets/tunnel",
        "to": "tunnel"
      }
    ]
  },
  "desktopName": "altseende-browser.desktop"
}
